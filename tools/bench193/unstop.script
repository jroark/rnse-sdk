# The clock block's registers at +0x30, +0x34 and +0x44 read 0xf, 1 and
# 1 on a unit: module stop bits, if the block is the R-Car H1's (bit 0
# of +0x34 the USB host's there).  Cleared a bit at a time, with the USB
# candidates read after each; blocks.script run afterwards shows which
# pages answer that did not.  A restart of the unit puts them back.
note before
r32 ffc80030 2
r32 ffc80044
note +0x34 bit 0 cleared
w32 ffc80034 0
r32 ffc80034
r32 ffe70000 2
r32 ffe70400 2
r32 ffe70800 4
r32 fff70000 2
r32 fff70400 2
note +0x30 bit 0 cleared
w32 ffc80030 e
r32 ffc80030
note +0x30 bit 1 cleared
w32 ffc80030 c
r32 ffc80030
note +0x30 bit 2 cleared
w32 ffc80030 8
r32 ffc80030
note +0x30 bit 3 cleared
w32 ffc80030 0
r32 ffc80030
note +0x44 bit 0 cleared
w32 ffc80044 0
r32 ffc80044
note after all
r32 ffe70000 2
r32 ffe70400 2
r32 ffe70800 4
r32 fff70000 2
r32 fff70400 2
info 1
info 7
