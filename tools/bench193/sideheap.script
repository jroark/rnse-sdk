r32 abf40000 4
r32 abf60000 4
r32 abf80000 4
r32 abfa0000 4
r32 abfc0000 4
note pass 1: the other stretches the emulator never wrote, a few places each
r32 a8400000 4
r32 a8c00000 4
r32 a9400000 4
r32 aab00000 4
r32 ab200000 4
r32 ab900000 4
r32 aba80000 4
r32 abc00000 4
info 1
