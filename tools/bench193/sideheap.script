r32 abfec000 4
r32 abfed000 4
r32 abfee000 4
r32 abfef000 4
note pass 1: the rest of that stretch (0x0bcd8000-0x0bfe0000), four words every 128 KiB
r32 abce0000 4
r32 abd00000 4
r32 abd20000 4
r32 abd40000 4
r32 abd60000 4
r32 abd80000 4
r32 abda0000 4
r32 abdc0000 4
r32 abde0000 4
